# Database Configuration
# For local development, SQLite is used by default
# For production, use PostgreSQL
DATABASE_URL=sqlite:///./data/dev.db
# DATABASE_URL=postgresql://jeevn:jeevn@localhost:5432/ashi

# Sentinel-2 Credentials (optional)
# If not provided, the system will fall back to stub ingest
SENTINEL_USER=your_copernicus_username
SENTINEL_PASS=your_copernicus_password

# NASA Earthdata Login (optional — for NISAR L-band soil moisture, task #4)
# Just your Earthdata account username + password (urs.earthdata.nasa.gov).
# There is NO separate API key. Catalog *search* needs no auth; *download*
# does — and you must first authorize the app once:
#   urs.earthdata.nasa.gov -> Applications -> Authorized Apps ->
#   approve "Alaska Satellite Facility Data Access" (+ accept the NISAR EULA).
# Without that step, downloads return 401/403 even with a correct password.
# If unset, the system falls back to Open-Meteo modelled soil moisture.
EARTHDATA_USER=your_earthdata_username
EARTHDATA_PASS=your_earthdata_password

# Download Sentinel-2 Products (optional)
# Set to "1" to download actual products, "0" to download metadata only
DOWNLOAD_PRODUCTS=0

# S3/MinIO Configuration (optional)
# For storing artifacts in object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# MLflow Configuration (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Real-time advisory & dry-spell alerts (docs/realtime_advisory.md)
# All optional — sensible defaults apply if unset.
PAST_DAYS=10
FORECAST_DAYS=7
DRY_DAY_MM=1.0
RAIN_PROB_PCT=30
DRY_SPELL_DAYS=5
LEACH_RAIN_MM=15
SENSOR_MAX_AGE_MIN=180
# Set to 1 to drop the low-confidence SoilGrids/pedotransfer NPK proxy tier.
# DISABLE_SOILGRIDS_NPK=1

# India Soil Health Card district N/P/K table builder (one-time, offline after).
# Needed only to (re)generate data/static/shc_district_npk.csv, not at runtime.
# DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
# SHC_RESOURCE_ID=district_macro_nutrient_resource_uuid

# Python Logging
PYTHONUNBUFFERED=1
