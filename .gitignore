*~
.DS_Store

# ── Runtime artifacts (rasters/JSON/CSV/cache) ──────────────────────────────
# Exclude everything inside data/ EXCEPT the bundled-dataset subdir below.
# We use `data/*` rather than `data/` so the directory itself isn't blocked
# from being walked — otherwise the `!data/static/` negation would be a
# no-op (git can't re-include children of an excluded parent directory).
data/*
*.log
*.err.log

# Bundled static datasets (small, CC-licensed) ship with the repo.
# Currently: ISRIC global salinity raster clipped to India (~13 MB,
# CC BY 4.0, Wageningen University & ISRIC).
!data/static/

# ── Environment / secrets ──────────────────────────────────────────────────
.env
.env.local
*.env

# ── Local databases ─────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Docker ──────────────────────────────────────────────────────────────────
.dockerignore

# ── Third-party branded reference (do not redistribute) ────────────────────
farmonaut_technologies_private_limited_jeevnaireport.pdf

# ── Claude Code session metadata ────────────────────────────────────────────
.claude/
